# ---------------- Unity ----------------
Library/
Temp/
Obj/
Build/
Builds/
UserSettings/
MemoryCaptures/
Recordings/

# Unity の Logs/ は unity/ 配下に限定して除外する。
# 素の "Logs/" にすると core.ignorecase=true な Windows では リポジトリ直下の
# logs/ にも一致してしまい、logs/.gitkeep を再包含できなくなるため。
unity/Logs/

# Unity が自動生成する IDE 用ファイル
*.csproj
*.sln
*.user
*.userprefs
.vs/
.idea/

# Unity が生成するその他
*.pidb
*.booproj
*.svd
sysinfo.txt
*.apk
*.aab
*.unitypackage
crashlytics-build.properties

# ---------------- このリポジトリ固有 ----------------
# batchmode ログ / テスト結果 XML は成果物なので追跡しない。
# ディレクトリごと除外すると .gitkeep を再包含できないので中身だけ除外する。
/logs/*

# 検証スクリーンショット (Step 1 以降で使う)。
/verify/shots/*

# RT を CPU へ読み戻した PNG と測定結果 (Step 11-3c)。
# `run_unity.ps1 -Method SolarSetup.DumpScreenTextures` でいつでも作り直せる。
/verify/rt/*

# XR 診断の出力 (Step 12 の準備)。
# `run_unity.ps1 -Method SolarSetup.CaptureXrStack` でいつでも作り直せる。
/verify/xr/*

# 外部アセットの原本 (Step 6)。リポジトリには入れない。
# 入手元・ライセンス・ファイル名は docs/02-assets.md に記録する。
# unity/Assets/ へ取り込んだ複製だけを追跡する。
/source_assets/*
# Asset Store のアセット (Step 11-0)。EULA が再配布を禁じるため追跡しない。
# 入手元・バージョン・取り込み手順は docs/asset-sources.md に記録する。
# フォルダの .meta も追跡しない。追跡すると、アセットが無いクローンで
# 空の ThirdParty だけが復元され、フォルダの有無での判定が壊れる。
/unity/Assets/ThirdParty/*
/unity/Assets/ThirdParty.meta

# ---------------- 例外 (必ずファイル末尾に置く) ----------------
# 空ディレクトリを git 上に残すための .gitkeep だけは追跡する。
!/logs/.gitkeep
!/verify/shots/.gitkeep

# スタンドアロンビルドの出力 (Step 7)
/build/
